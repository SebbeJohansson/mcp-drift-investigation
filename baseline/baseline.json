              "description": "OK"
            },
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "Not found"
            }
          }
        }
      }
    },
    "security": [
      {
        "auth": []
      }
    ]
  },
